# Frontend (Vite) — chaves públicas, seguras para versionar como exemplo
VITE_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua_anon_publishable_key

# Opcional (apenas se você for rodar/deployar edge functions próprias):
# SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=  # NUNCA versionar — use só localmente / em CI secret
# LOVABLE_API_KEY=            # AI Gateway (gerenciada pelo Lovable em produção)
# RESEND_API_KEY=             # emails
# CLOUDFLARE_*                # vídeos
